def render_img_html(image_path: str, alt: str = "CIVIA image", circular: bool = True) -> str:
    """Devuelve un <img> en base64 si existe el archivo, o un espacio reservado para imagen."""
    p = Path(image_path)
    radius = "50%" if circular else "14px"
    if p.exists() and p.is_file():
        suffix = p.suffix.lower().lstrip(".")
        mime = "jpeg" if suffix == "jpg" else suffix or "png"
        b64 = base64.b64encode(p.read_bytes()).decode("utf-8")
        return (
            f'<img src="data:image/{mime};base64,{b64}" alt="{alt}" '
            f'style="width:74px; height:74px; object-fit:cover; border-radius:{radius}; '
            f'border:2px solid rgba(255,255,255,0.35); background:#FFFFFF;" />'
        )
    return (
        f'<div title="Coloca tu imagen en: {image_path}" '
        f'style="width:74px; height:74px; border-radius:{radius}; '
        f'border:2px dashed rgba(255,255,255,0.55); background:rgba(255,255,255,0.08); '
        f'color:#CBE7F0; display:flex; flex-direction:column; align-items:center; '
        f'justify-content:center; font-size:0.65rem; font-weight:700; text-align:center; '
        f'line-height:1.15; padding:4px; flex-shrink:0;">'
        f'<span>🖼️</span><span>IMG</span></div>'
    )


